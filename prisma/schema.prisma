generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model People {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    firstName       String
    lastName        String
    email           String
    homeAddress     String?
    age             String?
    contact         String?
    section         String?
    adviser         String?
    profile         String?
    profilePublicId String?
    password        String
    role            Int
    // true for records that belong to the public demo; demo users only see these
    isDemo          Boolean?
    // The demo visitor whose copy of the demo data this is. Unset on the three
    // shared demo accounts.
    demoVisitorId   String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

model Facephotos {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    owner          String
    photoPublicId  String
    photoUrl       String
    faceDescriptor String
    isDemo         Boolean?
    demoVisitorId  String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

// A demo visitor's browser, identified by the random ID in its
// afratinhs_visitor cookie. Each visitor gets their own copy of the premade
// demo data; it and everything tagged with the visitorId is deleted 24 hours
// after createdAt, when the cookie also expires.
model Demovisitors {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    visitorId String
    createdAt DateTime @default(now())
}

// Face data registered by demo visitors, one row per photo (3 per visitor).
// No photo is stored, only the descriptor.
model Demofaces {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    visitorId      String
    faceDescriptor String
    createdAt      DateTime @default(now())
}

model Attendance {
    id            String   @id @default(auto()) @map("_id") @db.ObjectId
    isOn          Boolean
    date          String
    time          String
    teacher       String
    event         String
    code          Int?
    section       String
    students      Json?
    isDemo        Boolean?
    // The demo visitor whose copy of the demo data this is.
    demoVisitorId String?
    // true for the 20-minute class created when a demo visitor logs in
    demoLive      Boolean?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

model Status {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    attendance     String
    studentId      String
    status         String
    letterUrl      String
    letterPublicId String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}
