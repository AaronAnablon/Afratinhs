generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model People {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    firstName       String
    lastName        String
    email           String
    homeAddress     String?
    age             String?
    contact         String?
    section         String?
    adviser         String?
    profile         String?
    profilePublicId String?
    password        String
    role            Int
    // true for records that belong to the public demo; demo users only see these
    isDemo          Boolean?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

model Facephotos {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    owner          String
    photoPublicId  String
    photoUrl       String
    faceDescriptor String
    isDemo         Boolean?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

// Face data registered by demo visitors. No photo is stored, only the
// descriptor, and rows expire 24 hours after createdAt.
model Demofaces {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    visitorId      String
    faceDescriptor String
    createdAt      DateTime @default(now())
}

model Attendance {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    isOn      Boolean
    date      String
    time      String
    teacher   String
    event     String
    code      Int?
    section   String
    students  Json?
    isDemo    Boolean?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Status {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    attendance     String
    studentId      String
    status         String
    letterUrl      String
    letterPublicId String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}
