DATABASE_URL=
NEXT_PUBLIC_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo accounts
# These are shown on the homepage so visitors can try each role with one click.
# Create them (plus a sample section and schedule) with: npm run seed:demo
# Re-running the seed resets their passwords and the demo schedule.
# Anyone using the admin demo can see and change every record, so point
# DATABASE_URL at a separate demo database, not one with real student data.
# Leave a role's email empty to hide it from the homepage.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="demo.admin@example.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="DemoAdmin@123"
NEXT_PUBLIC_DEMO_TEACHER_EMAIL="demo.teacher@example.com"
NEXT_PUBLIC_DEMO_TEACHER_PASSWORD="DemoTeacher@123"
NEXT_PUBLIC_DEMO_STUDENT_EMAIL="demo.student@example.com"
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD="DemoStudent@123"
